    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/client": "^5.2.0",
    "bcryptjs": "^2.4.3",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.2",
    "@types/uuid": "^9.0.2",
    "prisma": "^5.2.0",
    "tsx": "^3.12.7",
    "typescript": "^5.1.6"
  }
}